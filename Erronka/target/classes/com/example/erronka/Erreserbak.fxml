<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.erronka.ErreserbakController"
            prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: #D9C5B4;">


    <Label text="Gestión de Reservas" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #A62940;" layoutX="250" layoutY="20"/>


    <VBox spacing="15" layoutX="50" layoutY="70">
        <HBox spacing="10">
            <Label text="Nombre:" style="-fx-text-fill: #A62940;" />
            <TextField fx:id="nameField" promptText="Ingrese su nombre" prefWidth="200"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Número de personas:" style="-fx-text-fill: #A62940;" />
            <TextField fx:id="peopleField" promptText="Número de personas" prefWidth="200"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Fecha:" style="-fx-text-fill: #A62940;" />
            <DatePicker fx:id="dateField" prefWidth="200"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Hora:" style="-fx-text-fill: #A62940;" />
            <TextField fx:id="timeField" promptText="Hora de la reserva (HH:MM)" prefWidth="200"/>
        </HBox>


        <Button text="Hacer Reserva" style="-fx-background-color: #A62940; -fx-text-fill: white;" layoutX="250" layoutY="230" onAction="#handleReservationAction"/>
    </VBox>


    <TableView fx:id="reservationsTable" layoutX="50" layoutY="300" prefWidth="600" prefHeight="150" style="-fx-background-color: white;">
        <columns>
            <TableColumn text="Nombre" fx:id="nameColumn" prefWidth="150" style="-fx-text-fill: #A62940;"/>
            <TableColumn text="Número de Personas" fx:id="peopleColumn" prefWidth="150" style="-fx-text-fill: #A62940;"/>
            <TableColumn text="Fecha" fx:id="dateColumn" prefWidth="150" style="-fx-text-fill: #A62940;"/>
            <TableColumn text="Hora" fx:id="timeColumn" prefWidth="150" style="-fx-text-fill: #A62940;"/>
        </columns>
    </TableView>

</AnchorPane>
