<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #D9C5B4;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.erronka.Controller.LangileaController">
    <children>
        <VBox spacing="15" layoutX="50" layoutY="50">
            <!-- DNI Field -->
            <HBox spacing="10">
                <Label text="DNI:" style="-fx-text-fill: #A62940;" />
                <TextField fx:id="dniField" promptText="DNI" prefWidth="200" />
            </HBox>
            <Button layoutX="10" layoutY="10" text="Volver" onAction="#handleBackButton" style="-fx-background-color: #A62940; -fx-text-fill: white;" fx:id="backButton" />

            <!-- Nombre Field -->
            <HBox spacing="10">
                <Label text="Nombre:" style="-fx-text-fill: #A62940;" />
                <TextField fx:id="nombreField" promptText="Nombre" prefWidth="200" />
            </HBox>

            <!-- Apellido1 Field -->
            <HBox spacing="10">
                <Label text="Apellido 1:" style="-fx-text-fill: #A62940;" />
                <TextField fx:id="apellido1Field" promptText="Apellido 1" prefWidth="200" />
            </HBox>

            <!-- Apellido2 Field -->
            <HBox spacing="10">
                <Label text="Apellido 2:" style="-fx-text-fill: #A62940;" />
                <TextField fx:id="apellido2Field" promptText="Apellido 2" prefWidth="200" />
            </HBox>

            <!-- Action Buttons -->
            <HBox spacing="10">
                <Button text="Guardar" style="-fx-background-color: #A62940; -fx-text-fill: white;" onAction="#onGuardarButtonClick" />
                <Button text="Eliminar" style="-fx-background-color: #F44336; -fx-text-fill: white;" onAction="#onEliminarButtonClick" />
            </HBox>
        </VBox>

        <!-- Langilea Table -->
        <TableView fx:id="langileaTable" layoutX="50" layoutY="350" prefWidth="700" prefHeight="150" onMouseClicked="#handleRowSelection">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" prefWidth="50" />
                <TableColumn text="DNI" fx:id="dniColumn" prefWidth="100" />
                <TableColumn text="Nombre" fx:id="nombreColumn" prefWidth="200" />
                <TableColumn text="Apellido 1" fx:id="apellido1Column" prefWidth="200" />
                <TableColumn text="Apellido 2" fx:id="apellido2Column" prefWidth="200" />
            </columns>
        </TableView>

        <!-- Action Buttons for Table -->
        <HBox spacing="10" layoutX="50" layoutY="520">
            <Button text="Modificar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#onGuardarButtonClick" />
            <Button text="Eliminar" style="-fx-background-color: #F44336; -fx-text-fill: white;" onAction="#onEliminarButtonClick" />
        </HBox>
    </children>
</AnchorPane>
