<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="chatPane" xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/20.0.2" fx:controller="com.example.erronka.Controller.ChatController">
    <children>
        <TextArea fx:id="chatDisplay" editable="false" wrapText="true"
                  AnchorPane.topAnchor="10.0"
                  AnchorPane.leftAnchor="10.0"
                  AnchorPane.rightAnchor="10.0"
                  AnchorPane.bottomAnchor="50.0" />
        <TextField fx:id="messageInput" promptText="Escribe un mensaje..."
                   AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="90.0"
                   AnchorPane.bottomAnchor="10.0" />
        <Button text="Enviar" onAction="#onSendMessageClick"
                AnchorPane.rightAnchor="10.0"
                AnchorPane.bottomAnchor="10.0" />
    </children>
</AnchorPane>
