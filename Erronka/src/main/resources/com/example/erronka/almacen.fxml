<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.erronka.Controller.AlmacenController"
            style="-fx-background-color: #D9C5B4;">
    <Button layoutX="10" layoutY="10" text="Volver" onAction="#handleBackButton" style="-fx-background-color: #A62940; -fx-text-fill: white;" fx:id="backButton" />

    <!-- Header Label -->
    <Label text="Gestión de Productos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #A62940;"
           layoutX="300" layoutY="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="50"/>

    <!-- Form for adding a new product -->
    <VBox spacing="15" layoutX="50" layoutY="70" AnchorPane.leftAnchor="50" AnchorPane.topAnchor="70">
        <HBox spacing="10">
            <Label text="Nombre:"/>
            <TextField fx:id="nameField" promptText="Nombre del producto"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Tipo:"/>
            <TextField fx:id="typeField" promptText="Tipo de producto"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Unidad de Medida:"/>
            <TextField fx:id="unitField" promptText="Unidad de medida"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Nota:"/>
            <TextField fx:id="noteField" promptText="Notas adicionales"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Duración:"/>
            <DatePicker fx:id="durationField"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Cantidad:"/>
            <TextField fx:id="quantityField" promptText="Cantidad disponible"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Mínimo:"/>
            <TextField fx:id="minField" promptText="Cantidad mínima"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Máximo:"/>
            <TextField fx:id="maxField" promptText="Cantidad máxima"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Activo:"/>
            <CheckBox fx:id="activeCheckBox"/>
        </HBox>
        <Button text="Añadir Producto" onAction="#handleAddProduct" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </VBox>

    <!-- Action Buttons for Update/Delete -->
    <HBox spacing="20" layoutX="50" layoutY="460" AnchorPane.leftAnchor="50" AnchorPane.topAnchor="460">
        <Button text="Modificar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#handleUpdateProduct" />
        <Button text="Eliminar" style="-fx-background-color: #F44336; -fx-text-fill: white;" onAction="#handleDeleteProduct" />
    </HBox>

    <!-- Product Table -->
    <TableView fx:id="productTable" prefHeight="200" layoutX="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="420">
        <columns>
            <TableColumn fx:id="idColumn" text="ID"/>
            <TableColumn fx:id="nameColumn" text="Nombre"/>
            <TableColumn fx:id="typeColumn" text="Tipo"/>
            <TableColumn fx:id="unitColumn" text="Unidad"/>
            <TableColumn fx:id="noteColumn" text="Nota"/>
            <TableColumn fx:id="durationColumn" text="Duración"/>
            <TableColumn fx:id="quantityColumn" text="Cantidad"/>
            <TableColumn fx:id="minColumn" text="Min"/>
            <TableColumn fx:id="maxColumn" text="Max"/>
            <TableColumn fx:id="activeColumn" text="Activo"/>
        </columns>
    </TableView>

</AnchorPane>
